# Exclude common Python files and directories
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyz
*.pyw
*.pyi
*.egg-info/

# Exclude development and local files
.env
.env.*
*.log
*.db
.DS_Store
.pytest_cache/
.ruff_cache/
.idea/
logs/

# Exclude version control system files
.git/
.gitignore
.svn/

storage/
config.toml

# promo-shorts (M0): compose 볼륨 디렉터리 — 이미지에 굽지 않는다 (bridge-secret 유출 방지)
data/
bridge-secret/

# GJC 에이전트 런타임 세션 상태 — 이미지에 굽지 않는다
.gjc/
